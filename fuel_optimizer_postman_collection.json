      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Los Angeles, CA\",\n  \"finish\": \"New York, NY\",\n  \"tank_range_miles\": 500,\n  \"mpg\": 10,\n  \"strategy\": \"cost_optimal\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/route-optimize/",
          "host": ["{{base_url}}"],
          "path": ["api", "route-optimize", ""]
        },
        "description": "Runs pure DAG Dynamic Programming to achieve global mathematical minimum fuel cost."
